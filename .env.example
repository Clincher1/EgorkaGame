# ===== Telegram =====
# Токен от @BotFather. Без него работает только браузерная версия.
BOT_TOKEN=

# polling — для локального запуска и VPS (бот сам ходит за обновлениями).
# webhook — для бесплатных хостингов со сном (Render и т.п.): Telegram будит сервис.
BOT_MODE=polling

# Публичный HTTPS-адрес приложения (обязателен для BOT_MODE=webhook).
# Пример: https://egor-game.onrender.com
WEBHOOK_URL=

# Адрес Telegram Mini App (обычно тот же публичный адрес).
# Если пусто — кнопка Mini App в боте не показывается.
WEBAPP_URL=

# ===== Веб-сервер =====
WEB_HOST=0.0.0.0
WEB_PORT=8080
# На Render порт подставляется автоматически в переменную PORT

# ===== Supabase (необязательно) =====
# Если обе переменные заданы — сохранения летят в Postgres Supabase,
# иначе пишутся в локальную папку saves/.
SUPABASE_URL=
SUPABASE_KEY=

# Каталог для JSON-сохранений при локальном хранилище
SAVES_DIR=saves

# ===== Правила платформ =====
# Цензура лексики: off (Telegram) | symbols (для VK, ;%:?*) | euphemism
CENSOR_MODE=off
# true — ноль ресурса приводит к концовке (Telegram);
# false — режим восстановления по таймеру (требование VK)
PERMADEATH=true

# ===== VK Mini Apps =====
# ID приложения и защищённый ключ из настроек на dev.vk.com.
# App ID «ПТОшник против Системы»: 54850918 (не секрет).
# Боевой VK_SECRET хранится только в env хостинга, не в git и не в чатах.
VK_APP_ID=54850918
VK_SECRET=
